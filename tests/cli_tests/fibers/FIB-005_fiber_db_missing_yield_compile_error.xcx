--- TEST: FIB-005
--- Runner: expect_compile_error = true
--- Area: Fibers
--- Priority: medium
--- Name: Fiber — DB operacje wymagają yield (brak yield → compile error)
--- Expect:
---   Ten plik NIE POWINIEN się skompilować.
---   Wywołanie db.fetch() bez yield wewnątrz fibera → compile error.
--- .
--- Runner: oczekiwany exit code kompilacji niezerowy.

database: app { engine = "sqlite", path = "tests_tmp/fib005.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s ]
    rows = [EMPTY]
};

fiber run(-> b) {
    --- LINIA KRYTYCZNA — brak yield:
    table: bad = app.fetch(users);
    return false;
};

>! "FAIL — brak yield przed DB operation nie wywołał błędu kompilacji";
