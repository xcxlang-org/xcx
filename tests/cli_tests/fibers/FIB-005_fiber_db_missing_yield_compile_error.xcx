--- TEST: FIB-005
--- Runner: expect_compile_error = true
--- Area: Fibers
--- Priority: medium
--- Name: Fiber — DB operations require yield (missing yield → compile error)
--- Expect:
---   This file SHOULD NOT compile.
---   Calling db.fetch() without yield inside fiber → compile error.
--- .
--- Runner: expected non-zero compilation exit code.

database: app { engine = "sqlite", path = "tests_tmp/fib005.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s ]
    rows = [EMPTY]
};

fiber run(-> b) {
    --- CRITICAL LINE — missing yield:
    table: bad = app.fetch(users);
    return false;
};

>! "FAIL — missing yield before DB operation did not trigger compile error";
