--- TEST: FIB-003
--- Area: Fibers
--- Priority: high
--- Name: break in for..in fiber → automatic .close()
--- Expect:
---   break inside for iterating fiber triggers .close().
---   After break: isDone() == true.
---   Values before break are correct.

fiber:i: inf_gen(-> i) {
    i: n = 0;
    while (true) do;
        yield n;
        n = n + 1;
    end;
    return -1;
};

fiber:i: fg = inf_gen();
array:i: collected {};

for val in fg do;
    collected.push(val);
    if (val == 4) then;
        break;
    end;
end;

--- ── Subtest 1: values before break ───────────────────────────────────
if (collected.size() == 5) then;
    >! "[FIB-003-1] PASS — collected 5 values (0..4)";
else;
    >! "[FIB-003-1] FAIL — collected " + s(collected.size()) + " values (expected 5)";
end;

if (collected.get(0) == 0 AND collected.get(4) == 4) then;
    >! "[FIB-003-1] PASS — values: 0..4 correct";
else;
    >! "[FIB-003-1] FAIL — first=" + s(collected.get(0)) + " last=" + s(collected.get(4));
end;

--- ── Subtest 2: isDone() after break ──────────────────────────────────────
if (fg.isDone()) then;
    >! "[FIB-003-2] PASS — isDone() = true after break (auto .close() triggered)";
else;
    >! "[FIB-003-2] FAIL — isDone() = false — .close() was not triggered";
end;
