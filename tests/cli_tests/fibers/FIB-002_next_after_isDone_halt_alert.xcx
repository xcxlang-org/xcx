--- TEST: FIB-002
--- Area: Fibers
--- Priority: high
--- Name: Fiber.next() after isDone() → halt.alert R306
--- Expect:
---   Calling .next() when isDone() == true → halt.alert.
---   halt.alert DOES NOT interrupt the VM (only prints to stderr and continues).
---   Line after invocation must execute.

fiber:i: small_gen(i: max -> i) {
    for v in 1 to max do;
        yield v;
    end;
    return -1;
};

fiber:i: fg = small_gen(2);

--- Fiber exhaustion
i: a = fg.next();   --- 1
i: b = fg.next();   --- 2
i: c = fg.next();   --- -1 (return value)

if (fg.isDone()) then;
    >! "[FIB-002] PASS — isDone() = true after exhaustion";
else;
    >! "[FIB-002] FAIL — isDone() = false — fiber is not completed";
end;

--- ── Calling .next() after isDone() ──────────────────────────────────────
--- Expected: halt.alert R306 — but VM continues!
fg.next();
>! "[FIB-002] PASS — VM continues after halt.alert R306 (next() after isDone())";

--- Second time for assurance
fg.next();
>! "[FIB-002] PASS — VM continues after second halt.alert R306";
