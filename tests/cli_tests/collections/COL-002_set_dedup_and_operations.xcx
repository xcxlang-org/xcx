--- TEST: COL-002
--- Area: Collections
--- Priority: high
--- Name: Set — automatic deduplication and set operations
--- Expect:
---   UNION {1,2,3,4,5,6,7}, INTERSECTION {3,4,5}, DIFFERENCE {1,2}
---   Adding a duplicate does not change size.
---   Picking random.choice from empty → false.

set:N: a {1,,5};
set:N: b {3,,7};

--- ── Subtest 1: UNION ────────────────────────────────────────────────────
set:N: u = a UNION b;
if (u.size() == 7) then;
    >! "[COL-002-1] PASS — UNION size = 7";
else;
    >! "[COL-002-1] FAIL — UNION size = " + s(u.size()) + " (expected 7)";
end;

--- ── Subtest 2: INTERSECTION ───────────────────────────────────────────
set:N: i = a INTERSECTION b;
if (i.size() == 3) then;
    >! "[COL-002-2] PASS — INTERSECTION size = 3";
else;
    >! "[COL-002-2] FAIL — INTERSECTION size = " + s(i.size()) + " (expected 3)";
end;
if (i.contains(3) AND i.contains(4) AND i.contains(5)) then;
    >! "[COL-002-2] PASS — INTERSECTION contains {3,4,5}";
else;
    >! "[COL-002-2] FAIL — INTERSECTION does not contain the expected elements";
end;

--- ── Subtest 3: DIFFERENCE ──────────────────────────────────────────────
set:N: d = a DIFFERENCE b;
if (d.size() == 2) then;
    >! "[COL-002-3] PASS — DIFFERENCE size = 2";
else;
    >! "[COL-002-3] FAIL — DIFFERENCE size = " + s(d.size()) + " (expected 2)";
end;
if (d.contains(1) AND d.contains(2)) then;
    >! "[COL-002-3] PASS — DIFFERENCE contains {1,2}";
else;
    >! "[COL-002-3] FAIL — DIFFERENCE does not contain the expected elements";
end;

--- ── Subtest 4: SYMMETRIC_DIFFERENCE ───────────────────────────────────
set:N: sd = a SYMMETRIC_DIFFERENCE b;
if (sd.size() == 4) then;
    >! "[COL-002-4] PASS — SYMMETRIC_DIFFERENCE size = 4";
else;
    >! "[COL-002-4] FAIL — SYMMETRIC_DIFFERENCE size = " + s(sd.size()) + " (expected 4)";
end;

--- ── Subtest 5: deduplication via add() ────────────────────────────────
i: size_before = a.size();
a.add(3);
i: size_after = a.size();
if (size_before == size_after) then;
    >! "[COL-002-5] PASS — add() of duplicate does not change size";
else;
    >! "[COL-002-5] FAIL — size changed from " + s(size_before) + " to " + s(size_after);
end;

--- ── Subtest 6: deduplication during initialization ────────────────────
set:N: dup {1, 2, 2, 3, 3, 3};
if (dup.size() == 3) then;
    >! "[COL-002-6] PASS — initialization deduplicates: size = 3";
else;
    >! "[COL-002-6] FAIL — size = " + s(dup.size()) + " (expected 3)";
end;

--- ── Subtest 7: random.choice from empty set → false ───────────────────
set:N: empty_set {};
b: picked = random.choice from empty_set;
if (picked == false) then;
    >! "[COL-002-7] PASS — random.choice from empty = false";
else;
    >! "[COL-002-7] FAIL — random.choice from empty returned other than false";
end;

--- ── Subtest 8: unicode operator aliases ──────────────────────────────
set:N: u2 = a ∪ b;
set:N: i2 = a ∩ b;
if (u2.size() == u.size() AND i2.size() == i.size()) then;
    >! "[COL-002-8] PASS — unicode operators ∪ ∩ yield the same results";
else;
    >! "[COL-002-8] FAIL — unicode operators yield different results than text-based ones";
end;
