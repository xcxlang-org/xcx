--- TEST: COL-003b
--- Area: Collections
--- Priority: high
--- Name: Table — .where() S301 valid workaround (parameter renaming)
--- Expect:
---   Renaming parameter to 't' eliminates S301 conflict.
---   Filtering works correctly.

database: db { engine = "sqlite", path = "tests_tmp/col003b.db" };

table: sessions {
    columns = [ id :: i @auto @pk, token :: s, user_id :: i ]
    rows = [EMPTY]
};

yield db.sync(sessions);
yield db.insert(sessions, "abc123", 1);
yield db.insert(sessions, "xyz789", 2);

--- Valid version — parameter 't' instead of 'token':
fiber verify(s: t -> b) {
    table: sess = db.sessions.where(token == t);

    if (sess.count() == 1) then;
        >! "[COL-003b] PASS — found 1 session for token: " + t;
        return true;
    else;
        >! "[COL-003b] FAIL — found " + s(sess.count()) + " sessions";
        return false;
    end;
    return false;
};

fiber:b: f1 = verify("abc123");
b: ok1 = f1.next();
if (ok1) then;
    >! "[COL-003b] PASS — verify('abc123') OK";
else;
    >! "[COL-003b] FAIL — verify('abc123')";
end;

fiber:b: f2 = verify("notexist");
b: ok2 = f2.next();
if (NOT ok2) then;
    >! "[COL-003b] PASS — verify('notexist') correctly returned false";
else;
    >! "[COL-003b] FAIL — verify('notexist') should return false";
end;

db.close();