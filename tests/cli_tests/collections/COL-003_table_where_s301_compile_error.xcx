--- TEST: COL-003
--- Runner: expect_compile_error = true
--- Area: Collections
--- Priority: high
--- Name: Table — .where() conflict S301 (column vs local variable)
--- Expect:
---   This file SHOULD NOT compile.
---   Compiler must report S301 when column name = parameter name.
--- .
--- Runner: expected non-zero compilation exit code, stderr contains "S301".

database: db { engine = "sqlite", path = "tests_tmp/col003.db" };

table: sessions {
    columns = [ id :: i @auto @pk, token :: s, user_id :: i ]
    rows = [EMPTY]
};

--- CRITICAL LINE — parameter 'token' conflicts with column 'token':
fiber verify(s: token) {
    table: sess = sessions.where(token == token);
    return;
};

>! "FAIL — S301 was not detected by the compiler";
