--- TEST: DB-003
--- Runner: expect_compile_error = true
--- Area: Database
--- Priority: critical
--- Name: db.remove() without .where() - compilation error D401
--- Expect:
---   This file must not compile.
---   Compiler must report D401 error when attempting to use db.remove() without .where().
---   If this file executes fully, it is a FAIL.

database: app { engine = "sqlite", path = "tests_tmp/db003.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s, age :: i ]
    rows = [EMPTY]
};

yield app.sync(users);
yield app.insert(users, "Alice", 25);

yield app.remove(users);

>! "FAIL - db.remove() without .where() did not trigger D401";
