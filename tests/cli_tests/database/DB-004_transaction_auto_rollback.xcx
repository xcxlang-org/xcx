--- TEST: DB-004
--- Area: Database
--- Priority: high
--- Name: Transaction - auto-rollback on halt.error (unique violation)
--- Expect:
---   Auto-rollback occurs after unique constraint violation in transaction.
---   Table remains empty - no rows are saved.

database: app { engine = "sqlite", path = "tests_tmp/db004.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s @unique, age :: i ]
    rows = [EMPTY]
};

yield app.sync(users);

yield app.truncate(users);

app.begin();
yield app.insert(users, "Alice", 25);
yield app.insert(users, "Alice", 30);
app.commit();

table: result = yield app.fetch(users);

if (result.count() == 0) then;
    >! "[DB-004] PASS - rollback works, table empty";
else;
    >! "[DB-004] FAIL - table has " + s(result.count()) + " rows (expected 0 after rollback)";
end;

app.close();
