--- TEST: DB-006
--- Area: Database
--- Priority: high
--- Name: queryRaw().first() - halt.error when no results
--- Expect:
---   .first() on empty result triggers halt.error.
---   .first() on non-empty result returns correct object.
---   COUNT(*) works via queryRaw().first().

database: app { engine = "sqlite", path = "tests_tmp/db006.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s, age :: i ]
    rows = [EMPTY]
};

fiber run(-> b) {
    yield app.sync(users);
    yield app.truncate(users);

    fiber test_empty(-> b) {
        json: row = yield app.queryRaw("SELECT * FROM users WHERE age > ?", [999]).first();
        >! "[DB-006-1] FAIL - .first() on empty result did not trigger halt.error";
        return false;
    };

    fiber:b: f1 = test_empty();
    f1.next();

    if (f1.isDone()) then;
        >! "[DB-006-1] PASS - fiber completed after halt.error in .first()";
    end;

    yield app.insert(users, "Alice", 25);
    yield app.insert(users, "Bob", 30);

    json: count_row = yield app.queryRaw("SELECT COUNT(*) as n FROM users").first();
    i: n;
    count_row.bind("n", n);

    if (n == 2) then;
        >! "[DB-006-2] PASS - COUNT(*) = 2";
    else;
        >! "[DB-006-2] FAIL - COUNT(*) = " + s(n) + " (expected 2)";
    end;

    json: results = yield app.queryRaw("SELECT * FROM users WHERE age > ?", [100]);

    if (results.size() == 0) then;
        >! "[DB-006-3] PASS - size() = 0, correctly avoiding .first()";
    else;
        >! "[DB-006-3] FAIL - size() = " + s(results.size());
    end;

    app.close();
    return true;
};

fiber:b: f = run();
f.next();
