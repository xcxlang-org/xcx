--- TEST: DB-007
--- Area: Database
--- Priority: regression
--- Name: Windows S101 - direct assignment of DB result in fiber (without workaround)
--- Expect:
---   If S101 still exists: "FAIL - S101" in stderr, fiber may crash.
---   If fixed (XCX 3.2+): "[DB-007] PASS" in stdout.

database: db { engine = "sqlite", path = "tests_tmp/db007.db" };

table: logs {
    columns = [ id :: i @auto @pk, msg :: s ]
    rows = [EMPTY]
};

yield db.sync(logs);

fiber run_direct(-> b) {
    b: exists = db.has(logs);

    if (exists) then;
        >! "[DB-007] PASS - direct assignment works (S101 fixed or non-Windows)";
        return true;
    else;
        >! "[DB-007] FAIL - db.has() returned false even though sync() succeeded";
        return false;
    end;
    return false;
};

fiber:b: f = run_direct();
b: result = f.next();

if (result) then;
    >! "[DB-007] PASS - fiber completed without S101";
else;
    >! "[DB-007] FAIL or KNOWN-REGRESSION (S101 still present)";
end;

db.close();
