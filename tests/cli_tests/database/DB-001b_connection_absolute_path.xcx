--- TEST: DB-001b
--- Area: Database
--- Priority: critical
--- Name: SQLite Connection - absolute path -> halt.fatal
--- Expect:
---   This file must exit with a non-zero exit code.
---   "[DB-001b] FAIL" must not appear in stdout.
--- Runner: expect_fatal_exit = true

database: bad_abs { engine = "sqlite", path = "/etc/xcx_test.db" };

table: items { columns = [ id :: i @auto @pk ] rows = [EMPTY] };

fiber run(-> b) {
    yield bad_abs.sync(items);
    >! "[DB-001b] FAIL - absolute path did not trigger halt.fatal";
    return false;
};

fiber:b: f = run();
f.next();
