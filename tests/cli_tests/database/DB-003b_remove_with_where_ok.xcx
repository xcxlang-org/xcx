--- TEST: DB-003b
--- Area: Database
--- Priority: critical
--- Name: db.remove() with .where() - correct usage
--- Expect:
---   remove().where() works - rows matching the condition are removed.
---   Rows not matching the condition remain.

database: app { engine = "sqlite", path = "tests_tmp/db003b.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s, age :: i ]
    rows = [EMPTY]
};

fiber run(-> b) {
    yield app.sync(users);
    yield app.insert(users, "Alice", 15);
    yield app.insert(users, "Bob", 30);
    yield app.insert(users, "Charlie", 12);

    yield app.remove(users).where(age < 18) as res;

    if (res.affected == 2) then;
        >! "[DB-003b] PASS - affected = 2 (Alice and Charlie removed)";
    else;
        >! "[DB-003b] FAIL - affected = " + s(res.affected) + " (expected 2)";
    end;

    table: remaining = yield app.fetch(users);

    if (remaining.count() == 1) then;
        >! "[DB-003b] PASS - 1 row remaining";
    else;
        >! "[DB-003b] FAIL - " + s(remaining.count()) + " rows remaining";
    end;

    if (remaining[0].name == "Bob") then;
        >! "[DB-003b] PASS - Bob remains";
    else;
        >! "[DB-003b] FAIL - remaining is: " + remaining[0].name;
    end;

    app.close();
    return true;
};

fiber:b: f = run();
f.next();
