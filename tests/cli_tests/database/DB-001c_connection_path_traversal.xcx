--- TEST: DB-001c
--- Area: Database
--- Priority: critical
--- Name: SQLite Connection - path traversal (..) -> halt.fatal
--- Expect:
---   This file must exit with a non-zero exit code.
---   "[DB-001c] FAIL" must not appear in stdout.
--- Runner: expect_fatal_exit = true

database: bad_trav { engine = "sqlite", path = "../../xcx_test.db" };

table: items { columns = [ id :: i @auto @pk ] rows = [EMPTY] };

fiber run(-> b) {
    yield bad_trav.sync(items);
    >! "[DB-001c] FAIL - path traversal did not trigger halt.fatal";
    return false;
};

fiber:b: f = run();
f.next();
