--- TEST: DB-005b
--- Runner: expect_compile_error = true
--- Area: Database
--- Priority: high
--- Name: db.fetch().where() - string method call -> compilation error
--- Expect:
---   This file must not compile.
---   Compiler must reject string method (.lower()) usage in .where() for db.fetch().
---   If this file executes fully, it is a FAIL.

database: app { engine = "sqlite", path = "tests_tmp/db005b.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s, age :: i ]
    rows = [EMPTY]
};

yield app.sync(users);

table: bad = yield app.fetch(users).where(name.lower() == "alice");

>! "FAIL - string method in where() did not trigger compilation error";
