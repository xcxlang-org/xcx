--- TEST: DB-001
--- Area: Database
--- Priority: critical
--- Name: SQLite Connection - lazy open and relative path
--- Expect:
---   1. Connection opens only on first use (sync), not at declaration.
---   2. Correct relative path -> OK
---   3. Absolute path -> halt.fatal (separate subtest in DB-001b)

database: app { engine = "sqlite", path = "tests_tmp/db001.db" };

table: items {
    columns = [ id :: i @auto @pk, label :: s ]
    rows = [EMPTY]
};

fiber run(-> b) {
    yield app.sync(items);
    >! "[DB-001] PASS - sync() opened connection and created table";

    yield app.insert(items, label = "hello") as r;
    if (r.insertId == 1) then;
        >! "[DB-001] PASS - insert OK, insertId=1";
    else;
        >! "[DB-001] FAIL - insertId = " + s(r.insertId) + " (expected 1)";
    end;

    table: all = yield app.fetch(items);
    if (all.count() == 1) then;
        >! "[DB-001] PASS - fetch returned 1 row";
    else;
        >! "[DB-001] FAIL - fetch returned " + s(all.count()) + " rows";
    end;

    app.close();
    return true;
};

fiber:b: f = run();
f.next();
