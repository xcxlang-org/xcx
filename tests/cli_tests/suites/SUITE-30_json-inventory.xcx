--- TEST: SUITE-30
--- Area: Applications
--- Priority: high
--- Name: JSON inventory (cargo-test twin of programs/30_json_inventory.xcx)
--- Note: exits nonzero via halt.error when any check fails

i: checks = 0;
i: failures = 0;
func expect(s: name, b: ok) {
    checks = checks + 1;
    if (ok) then;
        >! "PASS: " + name;
    else;
        failures = failures + 1;
        >! "FAIL: " + name;
    end;
};

json: catalog <<< {"items": [], "total_value": 0} >>>;

json: a <<< {"sku": "", "qty": 0, "price": 0.0} >>>;
a.set("sku", "A-100");
a.set("qty", 4);
a.set("price", 2.5);
catalog.get("items").push(a);

json: b <<< {"sku": "", "qty": 0, "price": 0.0} >>>;
b.set("sku", "B-200");
b.set("qty", 10);
b.set("price", 1.2);
catalog.get("items").push(b);

expect("two items", catalog.get("items").size() == 2);
expect("first sku", catalog.get("items").get(0).get("sku").toStr() == "A-100");

i: n = catalog.get("items").size();
f: total = 0.0;
for i in 0 to n - 1 do;
    json: it = catalog.get("items").get(i);
    i: q = 0;
    f: p = 0.0;
    it.bind("qty", q);
    it.bind("price", p);
    total = total + f(q) * p;
end;
catalog.set("total_value", total);

f: tv = 0.0;
catalog.bind("total_value", tv);
expect("total value computed", tv > 21.999 && tv < 22.001);

table: inv {
    columns = [ sku :: s, qty :: i, price :: f ]
    rows = [EMPTY]
};
map: mapping {
    schema = [s <-> s]
    data = [ "sku" :: "sku", "qty" :: "qty", "price" :: "price" ]
};
catalog.inject("items", mapping, inv);

expect("table rows", inv.count() == 2);
expect("row 0 sku", inv.get(0).sku == "A-100");
expect("row 0 qty", inv.get(0).qty == 4);
expect("row 1 price", inv.get(1).price > 1.19 && inv.get(1).price < 1.21);

table: bulk = inv.where(qty > 5);
expect("bulk filter", bulk.count() == 1);
expect("bulk sku", bulk.get(0).sku == "B-200");

if (failures == 0) then;
    >! "SUITE RESULT: PASS (" + s(checks) + " checks)";
else;
    >! "SUITE RESULT: FAIL (" + s(failures) + " of " + s(checks) + " checks failed)";
    halt.error >! "SUITE-30 failed";
end;
