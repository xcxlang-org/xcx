--- TEST: CTL-002
--- Area: Control Flow
--- Priority: medium
--- Name: Recursion — limit 800 frames → halt.error
--- Expect:
---   Exceeding 800 recursion frames → halt.error (not halt.fatal, not crash).
---   VM continues after returning from frame.
---   Valid recursion (factorial 10) works.

--- ── Subtest 1: deep recursion → halt.error ─────────────────────────
func deep(i: n -> i) {
    return deep(n + 1);
};

func try_deep(-> b) {
    i: result = deep(0);
    >! "[CTL-002-1] FAIL — recursion did not trigger halt.error after 800 frames";
    return false;
};

try_deep();
>! "[CTL-002-1] PASS — halt.error after exceeding 800 frames, VM alive";

--- ── Subtest 2: valid recursion — factorial ─────────────────────────
func factorial(i: n -> i) {
    if (n <= 1) then;
        return 1;
    else;
        return n * factorial(n - 1);
    end;
};

i: f5 = factorial(5);
if (f5 == 120) then;
    >! "[CTL-002-2] PASS — factorial(5) = 120";
else;
    >! "[CTL-002-2] FAIL — factorial(5) = " + s(f5);
end;

i: f10 = factorial(10);
if (f10 == 3628800) then;
    >! "[CTL-002-2] PASS — factorial(10) = 3628800";
else;
    >! "[CTL-002-2] FAIL — factorial(10) = " + s(f10);
end;
