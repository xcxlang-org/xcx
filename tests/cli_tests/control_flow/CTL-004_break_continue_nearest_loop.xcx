--- TEST: CTL-004
--- Area: Control Flow
--- Priority: medium
--- Name: break i continue — tylko nearest loop
--- Expect:
---   break/continue wpływają wyłącznie na bezpośrednio otaczający loop.
---   Zewnętrzny loop kontynuuje po break wewnętrznym.

--- ── Subtest 1: break w zagnieżdżonej pętli ─────────────────────────────
i: outer_count = 0;
i: inner_total = 0;

for i in 1 to 3 do;
    outer_count = outer_count + 1;
    for j in 1 to 5 do;
        if (j == 3) then;
            break;   --- przerywa tylko wewnętrzną pętlę
        end;
        inner_total = inner_total + 1;
    end;
end;

if (outer_count == 3) then;
    >! "[CTL-004-1] PASS — outer loop wykonał się 3 razy";
else;
    >! "[CTL-004-1] FAIL — outer_count = " + s(outer_count) + " (oczekiwane 3)";
end;

--- Wewnętrzna pętla zbiera j=1, j=2 (break przy j=3), 3 razy → 6
if (inner_total == 6) then;
    >! "[CTL-004-1] PASS — inner_total = 6 (2 iteracje × 3)";
else;
    >! "[CTL-004-1] FAIL — inner_total = " + s(inner_total) + " (oczekiwane 6)";
end;

--- ── Subtest 2: continue w zagnieżdżonej pętli ──────────────────────────
array:i: collected {};

for a in 1 to 3 do;
    for b in 1 to 3 do;
        if (b == 2) then;
            continue;   --- skacze do następnej iteracji wewnętrznej
        end;
        collected.push(a * 10 + b);
    end;
end;

--- Oczekiwane: 11, 13, 21, 23, 31, 33 (b=2 pominięte)
if (collected.size() == 6) then;
    >! "[CTL-004-2] PASS — continue pominął b=2, zebrano 6 elementów";
else;
    >! "[CTL-004-2] FAIL — zebrano " + s(collected.size()) + " elementów (oczekiwane 6)";
end;

if (collected.get(0) == 11 AND collected.get(1) == 13) then;
    >! "[CTL-004-2] PASS — pierwsza para: 11, 13";
else;
    >! "[CTL-004-2] FAIL — pierwsza para: " + s(collected.get(0)) + ", " + s(collected.get(1));
end;

--- ── Subtest 3: continue w pojedynczej pętli ────────────────────────────
array:i: odds {};
for n in 1 to 10 do;
    if (n % 2 == 0) then; continue; end;
    odds.push(n);
end;

if (odds.size() == 5) then;
    >! "[CTL-004-3] PASS — zebrano 5 nieparzystych (1,3,5,7,9)";
else;
    >! "[CTL-004-3] FAIL — zebrano " + s(odds.size()) + " (oczekiwane 5)";
end;
