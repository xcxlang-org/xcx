--- TEST: CTL-004
--- Area: Control Flow
--- Priority: medium
--- Name: break and continue — only nearest loop
--- Expect:
---   break/continue only affect the directly surrounding loop.
---   The outer loop continues after inner break.

--- ── Subtest 1: break in nested loop ─────────────────────────────
i: outer_count = 0;
i: inner_total = 0;

for i in 1 to 3 do;
    outer_count = outer_count + 1;
    for j in 1 to 5 do;
        if (j == 3) then;
            break;   --- breaks only the inner loop
        end;
        inner_total = inner_total + 1;
    end;
end;

if (outer_count == 3) then;
    >! "[CTL-004-1] PASS — outer loop executed 3 times";
else;
    >! "[CTL-004-1] FAIL — outer_count = " + s(outer_count) + " (expected 3)";
end;

--- The inner loop collects j=1, j=2 (break on j=3), 3 times → 6
if (inner_total == 6) then;
    >! "[CTL-004-1] PASS — inner_total = 6 (2 iterations * 3)";
else;
    >! "[CTL-004-1] FAIL — inner_total = " + s(inner_total) + " (expected 6)";
end;

--- ── Subtest 2: continue in nested loop ──────────────────────────
array:i: collected {};

for a in 1 to 3 do;
    for b in 1 to 3 do;
        if (b == 2) then;
            continue;   --- jumps to next inner iteration
        end;
        collected.push(a * 10 + b);
    end;
end;

--- Expected: 11, 13, 21, 23, 31, 33 (b=2 skipped)
if (collected.size() == 6) then;
    >! "[CTL-004-2] PASS — continue skipped b=2, collected 6 elements";
else;
    >! "[CTL-004-2] FAIL — collected " + s(collected.size()) + " elements (expected 6)";
end;

if (collected.get(0) == 11 AND collected.get(1) == 13) then;
    >! "[CTL-004-2] PASS — first pair: 11, 13";
else;
    >! "[CTL-004-2] FAIL — first pair: " + s(collected.get(0)) + ", " + s(collected.get(1));
end;

--- ── Subtest 3: continue in single loop ────────────────────────────
array:i: odds {};
for n in 1 to 10 do;
    if (n % 2 == 0) then; continue; end;
    odds.push(n);
end;

if (odds.size() == 5) then;
    >! "[CTL-004-3] PASS — collected 5 odds (1,3,5,7,9)";
else;
    >! "[CTL-004-3] FAIL — collected " + s(odds.size()) + " (expected 5)";
end;
