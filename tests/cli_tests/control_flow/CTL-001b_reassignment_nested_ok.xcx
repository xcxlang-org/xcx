--- TEST: CTL-001b
--- Area: Control Flow
--- Priority: high
--- Name: Reassignment w zagnieżdżonym scope — poprawne
--- Expect:
---   Reassignment (bez redeclaracji) jest dozwolony.
---   Modyfikacja zewnętrznej zmiennej wewnątrz bloku jest widoczna na zewnątrz.

i: x = 10;
i: y = 5;

if (true) then;
    x = 20;      --- reassignment — OK
    y = y + 1;
end;

if (x == 20) then;
    >! "[CTL-001b] PASS — reassignment x = 20 widoczne po bloku";
else;
    >! "[CTL-001b] FAIL — x = " + s(x) + " (oczekiwane 20)";
end;

if (y == 6) then;
    >! "[CTL-001b] PASS — reassignment y = 6 widoczne po bloku";
else;
    >! "[CTL-001b] FAIL — y = " + s(y) + " (oczekiwane 6)";
end;

--- Zagnieżdżone bloki
i: counter = 0;
for i in 1 to 5 do;
    counter = counter + i;
end;

if (counter == 15) then;
    >! "[CTL-001b] PASS — counter po for = 15";
else;
    >! "[CTL-001b] FAIL — counter = " + s(counter);
end;
