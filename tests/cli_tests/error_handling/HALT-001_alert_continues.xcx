--- TEST: HALT-001
--- Area: Error Handling
--- Priority: critical
--- Name: halt.alert — execution continuation
--- Expect:
---   halt.alert prints message to stderr/stdout.
---   Execution continues — the next line must execute.
---   Multiple halt.alerts — all continue.

>! "[HALT-001] Before halt.alert";

halt.alert >! "HALT-ALERT-1: This is a warning — VM should continue";

>! "[HALT-001] PASS — line AFTER first halt.alert executed";

halt.alert >! "HALT-ALERT-2: Second warning";

>! "[HALT-001] PASS — line AFTER second halt.alert executed";

--- halt.alert inside function
func risky_op(-> b) {
    halt.alert >! "HALT-ALERT-3: alert inside function";
    return true;
};

b: result = risky_op();
if (result == true) then;
    >! "[HALT-001] PASS — function with halt.alert returned true";
else;
    >! "[HALT-001] FAIL — function with halt.alert did not return true";
end;

>! "[HALT-001] PASS — halt.alert does not interrupt execution";
