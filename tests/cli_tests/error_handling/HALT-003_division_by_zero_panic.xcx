--- TEST: HALT-003
--- Area: Error Handling
--- Priority: high
--- Name: Division by zero — automatic panic
--- Expect:
---   x / 0 triggers halt (halt.error or halt.fatal).
---   Modulo by 0 triggers halt.
---   Float / 0.0 triggers halt.
---   NOTE: modulo by 0 might return false (XCX bug) — the test records this.

--- ── Subtest 1: integer / 0 ─────────────────────────────────────────────
func try_div_zero(-> b) {
    i: x = 10;
    i: y = 0;
    i: z = x / y;
    >! "[HALT-003-1] FAIL — int/0 did not trigger halt (result=" + s(z) + ")";
    return false;
};
try_div_zero();
>! "[HALT-003-1] PASS — int/0 triggered halt, VM alive";

--- ── Subtest 2: modulo by 0 ─────────────────────────────────────────
--- KNOWN BUG: XCX 4.1 might return false instead of halt for modulo/0
func try_mod_zero(-> b) {
    i: a = 7;
    i: b = 0;
    i: r = a % b;
    >! "[HALT-003-2] FAIL — modulo/0 did not trigger halt (result=" + s(r) + ") [BUG XCX-3.1]";
    return false;
};
try_mod_zero();
>! "[HALT-003-2] PASS — modulo/0 triggered halt";

--- ── Subtest 3: float / 0.0 ────────────────────────────────────────────
func try_float_zero(-> b) {
    f: x = 10.0;
    f: y = 0.0;
    f: z = x / y;
    >! "[HALT-003-3] FAIL — float/0 did not trigger halt (result=" + s(z) + ")";
    return false;
};
try_float_zero();
>! "[HALT-003-3] PASS — float/0 triggered halt";

>! "[HALT-003] All subtest runs completed";
