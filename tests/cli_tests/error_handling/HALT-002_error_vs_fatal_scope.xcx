--- TEST: HALT-002
--- Area: Error Handling
--- Priority: critical
--- Name: halt.error — interrupts frame, VM alive after return
--- Expect:
---   halt.error inside function interrupts that function.
---   Line after function call (in main scope) MUST execute — VM alive.
---   No non-zero exit — halt.error does not terminate VM.

--- ── Subtest 1: halt.error in function — VM alive ─────────────────────────
func will_error(i: n -> i) {
    if (n == 0) then;
        halt.error >! "HALT-ERROR: zero provided!";
        return -1;
    end;
    return n * 2;
};

will_error(0);
>! "[HALT-002-1] PASS — VM alive after halt.error in function";

i: r2 = will_error(5);
if (r2 == 10) then;
    >! "[HALT-002-2] PASS — will_error(5) = 10";
else;
    >! "[HALT-002-2] FAIL — will_error(5) = " + s(r2);
end;

--- ── Subtest 2: halt.error in fiber — fiber terminates, VM alive ────────
fiber:i err_fiber(-> i) {
    yield 1;
    halt.error >! "HALT-ERROR: error in fiber";
    yield 2;
    return 0;
};

fiber:i: fe = err_fiber();
i: v1 = fe.next();

if (v1 == 1) then;
    >! "[HALT-002-3] PASS — fiber emitted 1 before error";
else;
    >! "[FIB-002-3] FAIL — fiber emitted " + s(v1);
end;

fe.next();
>! "[HALT-002-4] PASS — VM alive after halt.error in fiber";
>! "[HALT-002] All subtests completed";
