--- TEST: SEC-001c
--- Area: Security
--- Priority: critical
--- Name: store — valid relative path → OK
--- Expect:
---   store.write(), store.read(), store.exists() with relative path work.
---   Written content = read content.

s: path = "tests_tmp/sec001c_test.txt";
s: content = "XCX 4.1 security test\nLine 2";

store.write(path, content);

if (store.exists(path)) then;
    >! "[SEC-001c] PASS — store.exists() = true after write()";
else;
    >! "[SEC-001c] FAIL — store.exists() = false after write()";
end;

s: read_back = store.read(path);
if (read_back == content) then;
    >! "[SEC-001c] PASS — store.read() returned the written content";
else;
    >! "[SEC-001c] FAIL — read_back ≠ content";
end;

store.delete(path);

if (NOT store.exists(path)) then;
    >! "[SEC-001c] PASS — store.delete() deleted the file";
else;
    >! "[SEC-001c] FAIL — file still exists after delete()";
end;
