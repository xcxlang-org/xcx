--- TEST: MIN-14
--- Area: Smoke
--- Priority: high
--- Name: Minimal recursion (fast companion of programs/14_recursion.xcx)

i: checks = 0;
i: failures = 0;
func expect(s: name, b: ok) {
    checks = checks + 1;
    if (ok) then;
        >! "PASS: " + name;
    else;
        failures = failures + 1;
        >! "FAIL: " + name;
    end;
};

func fib(i: n -> i) {
    if (n <= 1) then;
        return n;
    end;
    return fib(n - 1) + fib(n - 2);
};
func fact(i: n -> i) {
    if (n <= 1) then;
        return 1;
    end;
    return n * fact(n - 1);
};
func is_even(i: n -> b) {
    if (n == 0) then;
        return true;
    end;
    return is_odd(n - 1);
};
func is_odd(i: n -> b) {
    if (n == 0) then;
        return false;
    end;
    return is_even(n - 1);
};

expect("fib 10", fib(10) == 55);
expect("fact 6", fact(6) == 720);
expect("mutual even", is_even(10));
expect("mutual odd", is_odd(7));

if (failures == 0) then;
    >! "SUITE RESULT: PASS (" + s(checks) + " checks)";
else;
    >! "SUITE RESULT: FAIL (" + s(failures) + " of " + s(checks) + " checks failed)";
    halt.error >! "MIN-14 failed";
end;
