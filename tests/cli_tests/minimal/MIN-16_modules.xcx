--- TEST: MIN-16
--- Area: Smoke
--- Priority: high
--- Name: Minimal modules (fast companion of programs/16_modules.xcx)

include "min_math.xcx" as m;
include "min_text.xcx";

i: checks = 0;
i: failures = 0;
func expect(s: name, b: ok) {
    checks = checks + 1;
    if (ok) then;
        >! "PASS: " + name;
    else;
        failures = failures + 1;
        >! "FAIL: " + name;
    end;
};

expect("aliased call", m.square(6) == 36);
expect("aliased const", m.TAU > 6.28 && m.TAU < 6.29);
expect("direct call", shout("hi") == "HI");
func square(i: x -> i) {
    return x + 1000;
};
expect("local no clash", square(2) == 1002 && m.square(2) == 4);

if (failures == 0) then;
    >! "SUITE RESULT: PASS (" + s(checks) + " checks)";
else;
    >! "SUITE RESULT: FAIL (" + s(failures) + " of " + s(checks) + " checks failed)";
    halt.error >! "MIN-16 failed";
end;
