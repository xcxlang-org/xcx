--- TEST: JSON-002
--- Area: JSON/HTTP
--- Priority: high
--- Name: json.push() on object → halt.error; on array → OK
--- Expect:
---   push() on JSON object → halt.error.
---   push() on JSON array → OK.
---   VM remains alive after halt.error.

json: arr_container <<< {"items": []} >>>;
json: elem <<< {"id": 1, "val": "test"} >>>;

--- ── Subtest 1: push() on JSON array → OK ───────────────────────────────
arr_container.get("items").push(elem);
i: size_after = arr_container.get("items").size();

if (size_after == 1) then;
    >! "[JSON-002-1] PASS — push() on JSON array works, size = 1";
else;
    >! "[JSON-002-1] FAIL — push() on JSON array, size = " + s(size_after);
end;

--- ── Subtest 2: push() on JSON object → halt.error ─────────────────────
func try_push_on_object(-> b) {
    json: obj <<< {"key": "value"} >>>;
    json: item <<< {"x": 1} >>>;
    obj.push(item);   --- must → halt.error
    >! "[JSON-002-2] FAIL — push() on JSON object did not trigger halt.error";
    return false;
};

try_push_on_object();
>! "[JSON-002-2] PASS — push() on JSON object triggered halt.error, VM alive";

--- ── Subtest 3: push() on container itself (object) → halt.error ────────
func try_push_on_container(-> b) {
    arr_container.push(elem);
    >! "[JSON-002-3] FAIL — push() on container-object did not trigger halt.error";
    return false;
};

try_push_on_container();
>! "[JSON-002-3] PASS — push() on arr_container object triggered halt.error";
