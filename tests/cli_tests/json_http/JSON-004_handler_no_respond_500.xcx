--- TEST: JSON-004
--- Area: JSON/HTTP
--- Priority: medium
--- Name: HTTP handler without net.respond() → automatic 500
--- Expect:
---   Handler that does not yield net.respond() causes HTTP 500 response.
---   Handler that yields net.respond(200, ...) works correctly.
--- .


--- ── Handler without respond ─────────────────────────────────────────────
fiber handle_broken(json: req -> json) {
    >! "[JSON-004] handle_broken called — missing net.respond()";
    --- intentionally missing yield net.respond(...)
};

--- ── Valid handler ────────────────────────────────────────────────────────
fiber handle_ok(json: req -> json) {
    yield net.respond(200, <<< {"status": "ok"} >>>);
};

--- ── Server ──────────────────────────────────────────────────────────────
--- NOTE: serve: is a terminal statement.
--- Runner executes this file as a separate process and tests via HTTP.
serve: test_app {
    port = 18404,
    host = "127.0.0.1",
    routes = [
        "GET /broken" :: handle_broken,
        "GET /ok"     :: handle_ok
    ]
};
