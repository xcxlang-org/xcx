--- TEST: JSON-001
--- Area: JSON/HTTP
--- Priority: critical
--- Name: json.parse() — halt.fatal on invalid JSON (R305)
--- Expect:
---   json.parse() with invalid string → immediate halt.fatal.
---   VM terminates — line after invocation will NOT execute.
--- Runner: expect_fatal_exit = true

s: bad_json = "{invalid: json, no quotes}";
>! "[JSON-001] Attempting to parse invalid JSON...";
json: p = json.parse(bad_json);

>! "[JSON-001] FAIL — json.parse() did not trigger halt.fatal (R305)";
