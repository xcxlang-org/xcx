--- TEST: DB-001
--- Area: Database
--- Priority: high
--- Name: Database Semantic Errors
--- Expect:
---   Failure of .where() logic with name collision or incorrect number of arguments.
--- Runner: expect_compile_error = true

database: app { engine = "sqlite", path = "dummy.db" };

table: users {
    columns = [ id :: i @auto @pk, name :: s, age :: i ]
    rows = [EMPTY]
};

--- S301
func verify(s: name) {
    db_users = users.where(name == name); --- Name collision between variable and column
};

--- D401
func wrong_remove() {
    yield app.remove(users); --- Missing .where() -> D401
};

--- S302
users.insert("Bob"); --- Schema requires 2 (name, age), gets 1 -> S302

>! "If this compiles, the test failed!";
