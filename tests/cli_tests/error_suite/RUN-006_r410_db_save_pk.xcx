--- TEST: RUN-006
--- Area: Error Handling
--- Priority: high
--- Name: R410 Save requires PK
--- Expect:
---   File returns 1 and exits with an error, runner treats it as success.
--- Runner: expect_fatal_exit = true

database: app { engine = "sqlite", path = "dummy.db" };

table: logs {
    columns = [ msg :: s ] --- NOTE: Missing @pk
    rows = [EMPTY]
};

yield app.save(logs); --- Halt (R410)
