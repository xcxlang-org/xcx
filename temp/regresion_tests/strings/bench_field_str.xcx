--- Benchmark: JSON field string append (100k iterations)
--- Tests pattern: data.set("field", data.get("field") + expr)
--- Measures whether StrAppendMember optimization fires vs baseline Add path

json: data = json.parse("{\"log\": \"\"}");
i: t0 = perf.us();

for i in 1 to 100000 do;
    data.set("log", data.get("log") + "a");
end;

i: t1 = perf.us();
f: ms = f(t1 - t0) / 1000.0;
i: len = data.get("log").length;
>! "Field str append 100k: " + s(ms) + " ms  |  len=" + s(len);
