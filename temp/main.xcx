---xcx runner for xcx >=4.0


--- 1. FIB(30) ---
func fib(i: n -> i) {
    if (n <= 1) then;
        return n;
    end;
    return fib(n - 1) + fib(n - 2);
};

i: t0 = perf.us();
i: res_fib = fib(30);
i: t1 = perf.us();
f: fib_ms = f(t1 - t0) / 1000.0;
>! "fib(30): " + s(fib_ms) + " ms (result=" + s(res_fib) + ")";


--- 2. LCG(100M) ---
i: state = 1;
i: iters = 100000000;
i: t2 = perf.us();
for i in 1 to iters do;
    state = (state * 1103515245 + 12345) % 2147483648;
end;
i: t3 = perf.us();
f: lcg_ms = f(t3 - t2) / 1000.0;
>! "lcg(100m): " + s(lcg_ms) + " ms (result=" + s(state) + ")";


--- 3. SIEVE(10M) ---
i: limit = 10000000;
array:b: sieve;

for i in 0 to limit do;
    sieve.push(true);
end;
sieve.update(0, false);
sieve.update(1, false);

i: t4 = perf.us();
i: p = 2;
while (p * p <= limit) do;
    if (sieve.get(p)) then;
        for m in (p * p) to limit @step p do;
            sieve.update(m, false);
        end;
    end;
    p = p + 1;
end;

i: prime_count = 0;
for i in 2 to limit do;
    if (sieve.get(i)) then;
        prime_count = prime_count + 1;
    end;
end;
i: t5 = perf.us();
f: sieve_ms = f(t5 - t4) / 1000.0;
>! "sieve: " + s(sieve_ms) + " ms (primes=" + s(prime_count) + ")";


--- 4. JSON (STDLIB) ---
table: payload_tbl {
    columns = [ id :: i, name :: s, active :: b ]
    rows = [EMPTY]
};

for i in 0 to 999 do;
    payload_tbl.add(i, "User_" + s(i), true);
end;

i: t6 = perf.us();
json: data = payload_tbl.toJson();
json: item = data.get(499);
s: extracted_name;
item.bind("name", extracted_name);
i: t7 = perf.us();
f: json_ms = f(t7 - t6) / 1000.0;
>! "json: " + s(json_ms) + " ms (extracted=" + extracted_name + ")";
