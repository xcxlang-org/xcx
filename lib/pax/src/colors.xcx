--- colors.xcx - ANSI Styling and Palette System for PAX UI

const s: C_RESET   = "\x1b[0m";
const s: C_BOLD    = "\x1b[1m";
const s: C_DIM     = "\x1b[2m";
const s: C_ITALIC  = "\x1b[3m";
const s: C_UNDER   = "\x1b[4m";

--- Foreground Colors
const s: C_BLACK   = "\x1b[30m";
const s: C_RED     = "\x1b[31m";
const s: C_GREEN   = "\x1b[32m";
const s: C_YELLOW  = "\x1b[33m";
const s: C_BLUE    = "\x1b[34m";
const s: C_MAGENTA = "\x1b[35m";
const s: C_CYAN    = "\x1b[36m";
const s: C_WHITE   = "\x1b[37m";

--- Bright Foreground
const s: C_BRED     = "\x1b[91m";
const s: C_BGREEN   = "\x1b[92m";
const s: C_BYELLOW  = "\x1b[93m";
const s: C_BBLUE    = "\x1b[94m";
const s: C_BMAGENTA = "\x1b[95m";
const s: C_BCYAN    = "\x1b[96m";
const s: C_BWHITE   = "\x1b[97m";

--- Backgrounds
const s: C_BG_BLUE  = "\x1b[44m";
const s: C_BG_CYAN  = "\x1b[46m";
const s: C_BG_GRAY  = "\x1b[100m";

--- Terminal Commands
const s: T_CLEAR  = "\x1b[2J\x1b[H";
const s: T_HIDE   = "\x1b[?25l";
const s: T_SHOW   = "\x1b[?25h";

--- Formatted status tags
func tagPax(-> s) {
    return C_BOLD + C_BCYAN + "[PAX]" + C_RESET;
};

func tagOk(-> s) {
    return C_BOLD + C_BGREEN + "[OK]" + C_RESET;
};

func tagInfo(-> s) {
    return C_BOLD + C_BBLUE + "[INFO]" + C_RESET;
};

func tagWarn(-> s) {
    return C_BOLD + C_BYELLOW + "[WARN]" + C_RESET;
};

func tagErr(-> s) {
    return C_BOLD + C_BRED + "[ERROR]" + C_RESET;
};

func colorize(s: text, s: color -> s) {
    return color + text + C_RESET;
};
