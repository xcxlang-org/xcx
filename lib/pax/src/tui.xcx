--- tui.xcx - Interactive TUI Navigation for PAX Package Manager

func renderHeader(s: projName, s: projVer, s: projAuthor, i: depCount) {
    >! T_CLEAR;
    >! C_BOLD + C_BCYAN + "  ==============================================================" + C_RESET;
    >! C_BOLD + C_BCYAN + "    PAX PACKAGE MANAGER v4.3 - INTERACTIVE DASHBOARD" + C_RESET;
    >! C_BOLD + C_BCYAN + "  ==============================================================" + C_RESET;
    >! "";
    >! C_BOLD + C_BWHITE + "  +-----------------------------------------------------------------+" + C_RESET;
    >! C_BOLD + C_BWHITE + "  |  " + C_BOLD + C_BCYAN + "Project:" + C_RESET + " " + C_BOLD + C_GREEN + projName + C_RESET + " (v" + projVer + ")" + C_RESET;
    >! C_BOLD + C_BWHITE + "  |  " + C_BOLD + C_BCYAN + "Author :" + C_RESET + " " + C_CYAN + projAuthor + C_RESET;
    >! C_BOLD + C_BWHITE + "  |  " + C_BOLD + C_BCYAN + "Status :" + C_RESET + " " + C_GREEN + s(depCount) + " dependencies declared" + C_RESET;
    >! C_BOLD + C_BWHITE + "  +-----------------------------------------------------------------+" + C_RESET;
    >! "";
};

func renderMenuItem(i: index, i: selected, s: icon, s: title, s: desc) {
    if (index == selected) then;
        >! "   " + C_BG_BLUE + C_BOLD + C_WHITE + " > [" + s(index + 1) + "] " + icon + "  " + title + " - " + desc + " " + C_RESET;
    else;
        >! "     " + C_CYAN + "[" + s(index + 1) + "] " + icon + "  " + title + C_RESET + C_DIM + " - " + desc + C_RESET;
    end;
};

func tuiReadline(s: prompt, s: defaultVal -> s) {
    .terminal !write prompt;
    .terminal !cursor on;
    
    s: val = defaultVal;
    if (val != "") then;
        .terminal !write val;
    end;

    while (true) do;
        s: k = input.key() @wait;
        if (k == "ENTER") then;
            break;
        elif (k == "BACKSPACE") then;
            i: len = val.length;
            if (len > 0) then;
                val = val.slice(0, len - 1);
                .terminal !write "\x08 \x08";
            end;
        elif (k == "ESC") then;
            val = "";
            break;
        else;
            if (k.length == 1) then;
                val = val + k;
                .terminal !write k;
            end;
        end;
    end;
    .terminal !cursor off;
    >! "";
    return val;
};

func showHelpScreen() {
    >! C_BOLD + C_BCYAN + "  ==============================================================" + C_RESET;
    >! C_BOLD + C_BCYAN + "    PAX PACKAGE MANAGER v4.3 - HELP & DOCUMENTATION" + C_RESET;
    >! C_BOLD + C_BCYAN + "  ==============================================================" + C_RESET;
    >! "";
    >! "  PAX is the official package management and upgrade tool for XCX.";
    >! "";
    >! C_BOLD + C_BYELLOW + "  Commands Overview:" + C_RESET;
    >! "   - " + C_BOLD + "Install Deps" + C_RESET + ": Downloads all dependencies declared in project.pax";
    >! "     into the local lib/ folder and keeps pax.lock updated.";
    >! "   - " + C_BOLD + "Add Package" + C_RESET + ": Appends a new dependency package name (with optional";
    >! "     version tags or URLs) to your project config and installs it.";
    >! "   - " + C_BOLD + "Search" + C_RESET + ": Performs a lookup query against the online package registry.";
    >! "   - " + C_BOLD + "Upgrade" + C_RESET + ": Fetches latest releases from GitHub and updates your";
    >! "     local installation of xcx (compiler & VM) and tools (stdlib).";
    >! "";
    >! C_BOLD + C_BYELLOW + "  Config File (project.pax):" + C_RESET;
    >! "   Declarative syntax mapping package name, version, author, description,";
    >! "   files array and dependencies list.";
    >! "";
    >! C_BOLD + C_BYELLOW + "  Dashboard Controls:" + C_RESET;
    >! "   - Arrow keys: Navigate through the commands.";
    >! "   - 1 to 8: Jump directly to a menu item.";
    >! "   - Enter: Run the selected action.";
    >! "   - Esc / Q: Exit the dashboard returning to the shell.";
};

func run_pax_tui() {
    s: projName = "No project (global scope)";
    s: projVer  = "0.0.0";
    s: projAuth = "N/A";
    i: depCount = 0;

    if (store.exists("project.pax")) then;
        json: cfg = parsePax(store.read("project.pax"));
        cfg.bind("name", projName);
        cfg.bind("version", projVer);
        cfg.bind("author", projAuth);
        depCount = cfg.get("deps").size();
    end;

    array:s: args = env.args();
    i: selected  = 0;
    i: totalItems = 8;
    b: running   = true;

    .terminal !raw;
    .terminal !cursor off;

    while (running) do;
        renderHeader(projName, projVer, projAuth, depCount);

        >! C_BOLD + C_BYELLOW + "  Arrows / 1-8 to move, Enter to select, Q/Esc to quit" + C_RESET;
        >! "";

        renderMenuItem(0, selected, "📦", "Install Deps ", "install all declared dependencies");
        renderMenuItem(1, selected, "➕", "Add Package  ", "add and install a new dependency");
        renderMenuItem(2, selected, "🔍", "Search       ", "search the PAX package registry");
        renderMenuItem(3, selected, "🚀", "Run          ", "execute the project entry point");
        renderMenuItem(4, selected, "⬆️ ", "Upgrade      ", "update XCX binary and tools");
        renderMenuItem(5, selected, "🎨", "Demo         ", "preview UI animations (developer)");
        renderMenuItem(6, selected, "❓", "Help         ", "show dashboard documentation");
        renderMenuItem(7, selected, "🚪", "Exit         ", "leave the TUI dashboard");

        >! "";

        s: k = input.key() @wait;

        if (k == "UP") then;
            selected = selected - 1;
            if (selected < 0) then; selected = totalItems - 1; end;
        elif (k == "DOWN") then;
            selected = selected + 1;
            if (selected >= totalItems) then; selected = 0; end;
        elif (k == "1") then; selected = 0;
        elif (k == "2") then; selected = 1;
        elif (k == "3") then; selected = 2;
        elif (k == "4") then; selected = 3;
        elif (k == "5") then; selected = 4;
        elif (k == "6") then; selected = 5;
        elif (k == "7") then; selected = 6;
        elif (k == "8") then; selected = 7;
        elif (k == "q" OR k == "Q" OR k == "ESC") then;
            running = false;
        end;

        if (k == "ENTER") then;
            if (selected == 0) then;
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                paxInstall(args);
            elif (selected == 1) then;
                s: pkgAdd = tuiReadline(C_BOLD + C_CYAN + "Package name to add (e.g. net_utils@1.0.0): " + C_RESET, "");
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                if (pkgAdd != "") then;
                    s: existingPax = "";
                    if (store.exists("project.pax")) then;
                        existingPax = store.read("project.pax");
                        json: addCfg = parsePax(existingPax);
                        addCfg.get("deps").push(pkgAdd);
                        store.write("project.pax", toPax(addCfg));
                        >! tagPax() + " Added " + pkgAdd + " to project.pax. Running install...";
                        paxInstall(args);
                    else;
                        >! tagErr() + " No project.pax found. Cannot add dependency.";
                    end;
                end;
            elif (selected == 2) then;
                s: qSearch = tuiReadline(C_BOLD + C_CYAN + "Search query: " + C_RESET, "");
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                if (qSearch != "") then;
                    array:s: searchArgs;
                    searchArgs.push("xcx");
                    searchArgs.push("pax");
                    searchArgs.push("search");
                    searchArgs.push(qSearch);
                    paxSearch(searchArgs);
                end;
            elif (selected == 3) then;
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                paxRun(args);
            elif (selected == 4) then;
                s: upTarget = tuiReadline(C_BOLD + C_CYAN + "Upgrade target (xcx / tools / all, default all): " + C_RESET, "all");
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                if (upTarget != "") then;
                    array:s: upArgs;
                    upArgs.push("xcx");
                    upArgs.push("pax");
                    upArgs.push("upgrade");
                    upArgs.push(upTarget);
                    paxUpgrade(upArgs);
                end;
            elif (selected == 5) then;
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                run_pax_demo();
            elif (selected == 6) then;
                .terminal !cursor on;
                .terminal !normal;
                >! T_CLEAR;
                showHelpScreen();
            elif (selected == 7) then;
                running = false;
            end;

            if (running) then;
                >! "";
                >! C_DIM + "Press any key to return to menu..." + C_RESET;
                .terminal !raw;
                .terminal !cursor off;
                input.key() @wait;
            end;
        end;
    end;

    .terminal !cursor on;
    .terminal !normal;
    >! T_CLEAR;
};
