--- pax.xcx - PAX Package Manager for XCX v4.3
include "colors.xcx";
include "progress.xcx";
include "tui.xcx";
include "demo.xcx";

const s: REGISTRY_HOST = "pax.xcxlang.com";
const s: TOKEN_FILE    = ".pax_token";
const s: CONFIG_FILE   = ".pax_config";

func getRegistryUrl(-> s) {
    s: host = REGISTRY_HOST;
    if (store.exists(CONFIG_FILE)) then;
        s: content = store.read(CONFIG_FILE);
        if (content.startsWith("{")) then;
            json: cfg = json.parse(content);
            if (cfg.exists("registry")) then;
                cfg.bind("registry", host);
            end;
        end;
    end;

    s: url = "";
    if (host.startsWith("http")) then;
        url = host;
    else;
        if (host.startsWith("localhost") OR host.startsWith("127.0.0.1")) then;
            url = "http://" + host;
        else;
            url = "https://" + host;
        end;
    end;
    
    if (NOT url.endsWith("/")) then;
        url = url + "/";
    end;
    
    return url;
};

func main() {
    array:s: args = env.args();
    
    if (args.size() < 3) then;
        run_pax_tui();
        return;
    end;
    
    s: command = args.get(2);
    
    if (command == "demo") then;
        run_pax_demo();
    elif (command == "new") then;
        paxNew(args);
    elif (command == "install") then;
        paxInstall(args);
    elif (command == "clone") then;
        paxClone(args);
    elif (command == "add") then;
        paxAdd(args);
    elif (command == "remove") then;
        paxRemove(args);
    elif (command == "search") then;
        paxSearch(args);
    elif (command == "run") then;
        paxRun(args);
    elif (command == "login") then;
        paxLogin(args);
    elif (command == "logout") then;
        paxLogout();
    elif (command == "whoami") then;
        paxWhoAmI();
    elif (command == "publish") then;
        paxPublish();
    elif (command == "upgrade") then;
        paxUpgrade(args);
    else;
        >! tagErr() + " Unknown command '" + command + "'";
    end;
};

--- ================================================================
---   Authentication Helpers
--- ================================================================

func saveToken(s: token) {
    store.write(TOKEN_FILE, token);
    >! tagOk() + " Authentication success! Token saved.";
};

func getToken(-> s) {
    if (store.exists(TOKEN_FILE)) then;
        return store.read(TOKEN_FILE).trim();
    end;
    return "";
};

func paxLogin(array:s: args) {
    if (args.size() < 4) then;
        >! C_BOLD + C_BYELLOW + "Usage: xcx pax login <token>" + C_RESET;
        return;
    end;
    saveToken(args.get(3));
};

func paxLogout() {
    if (store.exists(TOKEN_FILE)) then;
        store.delete(TOKEN_FILE);
        >! tagPax() + " Session terminated. Token removed.";
    else;
        >! tagWarn() + " No active session found.";
    end;
};

func paxWhoAmI() {
    s: token = getToken();
    if (token == "") then;
        >! tagErr() + " Not logged in. Use 'xcx pax login <token>'.";
        return;
    end;
    
    map: authHeaders {
        schema = [s <-> s]
        data = ["X-PAX-TOKEN" :: token]
    };
    
    net.request {
        method  = "GET",
        url     = getRegistryUrl() + "api?route=api/whoami",
        headers = authHeaders,
        timeout = 5000,
    } as resp;
    
    if (resp.ok) then;
        s: body = s(resp.body);
        if (body.startsWith("{")) then;
            json: data = resp.body;
            if (data.exists("username")) then;
                s: user; data.bind("username", user);
                s: role; data.bind("role", role);
                >! tagOk() + " Account: " + C_BOLD + user + C_RESET + " [" + C_CYAN + role + C_RESET + "]";
            else;
                >! tagErr() + " Registry returned unexpected JSON format.";
            end;
        else;
            >! tagErr() + " Registry returned non-JSON response: " + body;
        end;
    else;
        >! tagErr() + " Auth Error: Status " + s(resp.status);
        if (resp.exists("error")) then; >! "  Details: " + s(resp.get("error")); end;
    end;
};

--- ================================================================
---   Configuration Helpers (PAX/JSON Mapping)
--- ================================================================

func parsePax(s: content -> json) {
    array:s: lines = content.split("\n");
    json: res <<< {"name": "unnamed", "version": "0.1.0", "author": "", "description": "", "main": "", "deps": [], "tags": [], "files": []} >>>;
    
    s: cK = "";
    for line in lines do;
        s: l = line.split("---").get(0).trim();
        if (l == "" OR l == "/") then; continue; end;

        if (l HAS "::") then;
            array:s: kv = l.split("::");
            if (kv.size() >= 2) then;
                s: k = kv.get(0).trim().lower();
                s: v = kv.get(1).trim();

                if (v HAS "\"") then;
                    array:s: b = v.split("\"");
                    if (b.size() >= 2) then;
                        s: val = b.get(1);
                        if (k == "name") then; res.set("name", val);
                        elif (k == "version") then; res.set("version", val);
                        elif (k == "author") then; res.set("author", val);
                        elif (k == "description") then; res.set("description", val);
                        elif (k == "main") then; res.set("main", val);
                        elif (k == "files") then; res.get("files").push(val);
                        end;
                    end;
                end;

                if (v HAS "[") then;
                    cK = k;
                    if (v HAS "]") then;
                        array:s: bits; bits = v.split("\"");
                        i: idx = 1;
                        while (idx < bits.size()) do;
                            if (cK == "deps") then; res.get("deps").push(bits.get(idx));
                            elif (cK == "tags") then; res.get("tags").push(bits.get(idx));
                            elif (cK == "files") then; res.get("files").push(bits.get(idx));
                            end;
                            idx = idx + 2;
                        end;
                        cK = "";
                    end;
                end;
            end;
        elif (cK != "") then;
            if (l HAS "\"") then;
                array:s: bits; bits = l.split("\"");
                i: idx = 1;
                while (idx < bits.size()) do;
                    if (cK == "deps") then; res.get("deps").push(bits.get(idx));
                    elif (cK == "tags") then; res.get("tags").push(bits.get(idx));
                    elif (cK == "files") then; res.get("files").push(bits.get(idx));
                    end;
                    idx = idx + 2;
                end;
            end;
            if (l HAS "]") then; cK = ""; end;
        end;
    end;
    return res;
};

func toPax(json: cfg -> s) {
    s: name; cfg.bind("name", name);
    s: ver;  cfg.bind("version", ver);
    s: auth; cfg.bind("author", auth);
    s: desc; cfg.bind("description", desc);
    array:s: deps = cfg.get("deps");
    array:s: tags = cfg.get("tags");
    array:s: filesX = cfg.get("files");
    
    s: res = "---\nPAX Project Configuration\n*---\n/\n";
    res = res + "    name        :: \"" + name + "\",\n";
    res = res + "    version     :: \"" + ver + "\",\n";
    res = res + "    author      :: \"" + auth + "\",\n";
    res = res + "    description :: \"" + desc + "\",\n";
    
    if (cfg.exists("main")) then;
        s: main_entry; cfg.bind("main", main_entry);
        if (main_entry != "") then;
            res = res + "    main        :: \"" + main_entry + "\",\n";
        end;
    end;
    
    res = res + "    tags  :: " + tags.toStr() + ",\n";
    res = res + "    files :: " + filesX.toStr() + ",\n";
    res = res + "    deps  :: [\n";
    for i in 0 to (deps.size() - 1) do;
        res = res + "        \"" + deps.get(i) + "\"";
        if (i < (deps.size() - 1)) then; res = res + ",\n"; end;
    end;
    res = res + "\n    ]\n/\n";
    return res;
};

--- ================================================================
---   Project Operations
--- ================================================================

func paxNew(array:s: args) {
    if (args.size() < 4) then;
        >! C_BOLD + C_BYELLOW + "Usage: xcx pax new <project_name>" + C_RESET;
        return;
    end;
    s: name = args.get(3);
    >! tagPax() + " Scaffolding project: " + C_BOLD + C_CYAN + name + C_RESET;
    
    store.mkdir(name + "/src");
    
    json: cfg <<< {"name": "", "version": "0.1.0", "author": "dev", "description": "PAX project", "deps": [], "tags": [], "files": []} >>>;
    cfg.set("name", name);
    
    store.write(name + "/project.pax", toPax(cfg));
    store.write(name + "/src/main.xcx", "func main() {\n    >! \"Hello from " + name + "!\";\n};\nmain();\n");
    store.write(name + "/README.md", "# " + name + "\nProfessional XCX project.");
    
    >! tagOk() + " Project created in ./" + C_BOLD + C_CYAN + name + C_RESET;
};

func paxRun(array:s: args) {
    s: target = "src/main.xcx";
    if (store.exists("project.pax")) then;
        json: cfg = parsePax(store.read("project.pax"));
        if (cfg.exists("main")) then;
            s: customMain; cfg.bind("main", customMain);
            if (customMain != "" AND store.exists(customMain)) then; target = customMain; end;
        end;
    end;

    if (args.size() > 3) then;
        target = args.get(3);
        if (store.exists(target + "/src/main.xcx")) then; target = target + "/src/main.xcx"; end;
    end;

    if (store.exists(target)) then;
        >! tagPax() + " Booting: " + C_BOLD + C_CYAN + target + C_RESET;
        if (NOT .terminal !run target) then;
            >! tagErr() + " Execution aborted.";
        end;
    else;
        >! tagErr() + " Target " + target + " not found.";
    end;
};

--- ================================================================
---   Dependency Management
--- ================================================================

func normalizeUrl(s: input -> s) {
    if (input.startsWith("http")) then; return input; end;
    s: name = input;
    s: ver  = "latest";
    if (input HAS "@") then;
        array:s: pts = input.split("@");
        name = pts.get(0).trim();
        ver  = pts.get(1).trim();
    end;
    return getRegistryUrl() + "api?route=api/packages/" + name + "/download&v=" + ver + "&format=json";
};

func getPackageName(s: input -> s) {
    s: name = input;
    if (input HAS "@") then; name = input.split("@").get(0).trim(); end;
    if (name HAS "/") then;
        array:s: pts = name.split("/");
        name = pts.get(pts.size() - 1);
    end;
    return name;
};

func updateLockfile(s: name, s: ver, s: path) {
    json: lock <<< {} >>>;
    if (store.exists("pax.lock")) then; lock = json.parse(store.read("pax.lock")); end;
    
    json: entry <<< {"version": "", "file": ""} >>>;
    entry.set("version", ver);
    entry.set("file", path);
    lock.set(name, entry);
    
    store.write("pax.lock", lock.toStr());
};

func fetchPackage(s: input, b: isFull) {
    s: url = normalizeUrl(input);
    s: pkg = getPackageName(input);
    s: token = getToken();
    
    map: headers {
        schema = [s <-> s]
        data = [EMPTY]
    };
    if (token != "") then; headers.insert("X-PAX-TOKEN", token); end;

    net.request {
        method = "GET",
        url = url,
        headers = headers,
        timeout = 15000,
    } as resp;

    if (resp.ok) then;
        s: body = s(resp.body);
        if (body.startsWith("{")) then;
            json: m = json.parse(body);
            json: fl;

            if (m.exists("files_list")) then;
                json: inner = m.get("files_list");
                if (inner.exists("files_list")) then;
                    fl = inner.get("files_list");
                else;
                    fl = inner;
                end;
            end;

            if (fl.size() == 0) then;
                >! tagErr() + " " + pkg + " has no file manifest.";
            else;
                s: lp = "lib/" + pkg + "/";
                store.mkdir(lp);

                --- For install mode: read the files list from the package's own project.pax
                array:s: allowedFiles;
                if (NOT isFull) then;
                    i: pi = 0;
                    i: psz = fl.size();
                    while (pi < psz) do;
                        json: pObj = fl.get(pi);
                        s: pp; pObj.bind("path", pp);
                        s: ppNorm = pp.lower().replace("\\", "/");
                        if (ppNorm == "project.pax" OR ppNorm == "./project.pax") then;
                            s: pc; pObj.bind("content", pc);
                            json: pkgCfg = parsePax(pc);
                            allowedFiles = pkgCfg.get("files");
                        end;
                        pi = pi + 1;
                    end;
                end;

                i: k = 0;
                i: sz = fl.size();
                while (k < sz) do;
                    json: fObj = fl.get(k);
                    s: p; fObj.bind("path", p);
                    s: c; fObj.bind("content", c);

                    --- Install mode: filter by declared files list
                    if (NOT isFull) then;
                        b: allowed = false;
                        s: pNorm = p.replace("\\", "/");

                        if (allowedFiles.size() == 0) then;
                            --- Fallback: skip known non-code files when package has no files field
                            s: pl = pNorm.lower();
                            b: isJunk = false;
                            if (pl == "readme.md" OR pl == "license" OR pl == "license.txt") then; isJunk = true; end;
                            if (pl.startsWith("tests/") OR pl.startsWith("docs/")) then; isJunk = true; end;
                            if (pl.startsWith(".git") OR pl.startsWith(".github")) then; isJunk = true; end;
                            if (pl == "project.pax" OR pl == "./project.pax") then; isJunk = true; end;
                            if (NOT isJunk) then; allowed = true; end;
                        else;
                            --- Match path against each entry in files list
                            i: ai = 0;
                            i: asz = allowedFiles.size();
                            while (ai < asz) do;
                                s: af = allowedFiles.get(ai).replace("\\", "/");
                                if (pNorm == af OR pNorm.endsWith("/" + af) OR af.endsWith("/" + pNorm)) then;
                                    allowed = true;
                                end;
                                ai = ai + 1;
                            end;
                        end;

                        if (NOT allowed) then; k = k + 1; continue; end;
                    end;

                    --- Directory handling (normalise to forward slashes)
                    s: pSlash = p.replace("\\", "/");
                    b: has_dir = pSlash HAS "/";
                    if (has_dir) then;
                        array:s: parts = pSlash.split("/");
                        s: curPath = lp;
                        for i in 0 to (parts.size() - 2) do;
                            curPath = curPath + parts.get(i) + "/";
                            if (NOT store.exists(curPath)) then; store.mkdir(curPath); end;
                        end;
                    end;

                    store.write(lp + pSlash, c);
                    k = k + 1;
                end;

                updateLockfile(pkg, input, lp);

                s: mode = "Installed";
                if (isFull) then; mode = "Cloned"; end;
                >! tagOk() + " " + mode + " " + C_BOLD + C_CYAN + pkg + C_RESET + " in " + lp;
            end;
        else;
            s: fn = "pkg_" + pkg + "_" + crypto.token(4) + ".xcx";
            store.write("lib/" + fn, resp.body);
            updateLockfile(pkg, input, "lib/" + fn);
            >! tagOk() + " Saved as lib/" + fn;
        end;
    else;
        >! tagErr() + " Failed: Status " + s(resp.status);
    end;
};

func paxInstall(array:s: args) {
    if (NOT store.exists("project.pax")) then;
        >! tagErr() + " project.pax not found.";
        return;
    end;
    
    json: cfg = parsePax(store.read("project.pax"));
    array:s: deps = cfg.get("deps");
    >! tagPax() + " Resolving " + C_BOLD + C_GREEN + s(deps.size()) + C_RESET + " dependencies...";
    
    array:s: fetched;
    for d in deps do;
        s: name = getPackageName(d);
        if (NOT fetched.contains(name)) then;
            >! tagInfo() + " Fetching " + C_CYAN + name + C_RESET + "...";
            fetchPackage(d, false);
            fetched.push(name);
        end;
    end;
    >! tagOk() + " Installation complete.";
};

func paxClone(array:s: args) {
    if (args.size() < 4) then;
        >! C_BOLD + C_BYELLOW + "Usage: xcx pax clone <package>" + C_RESET;
        return;
    end;
    s: target = args.get(3);
    >! tagPax() + " Cloning package " + C_BOLD + C_CYAN + target + C_RESET + "...";
    fetchPackage(target, true);
};

func paxAdd(array:s: args) {
    if (args.size() < 4 OR NOT store.exists("project.pax")) then;
        >! C_BOLD + C_BYELLOW + "Usage: xcx pax add <package>" + C_RESET;
        return;
    end;
    
    s: name = args.get(3);
    json: cfg = parsePax(store.read("project.pax"));
    cfg.get("deps").push(name);
    store.write("project.pax", toPax(cfg));
    >! tagPax() + " Added " + C_BOLD + C_CYAN + name + C_RESET + " to project.pax. Running install...";
    paxInstall(args);
};

func paxRemove(array:s: args) {
    if (args.size() < 4 OR NOT store.exists("project.pax")) then;
        >! C_BOLD + C_BYELLOW + "Usage: xcx pax remove <package>" + C_RESET;
        return;
    end;
    s: target = args.get(3);
    json: cfg = parsePax(store.read("project.pax"));
    array:s: deps = cfg.get("deps");
    i: idx = -1;
    for i in 0 to (deps.size() - 1) do;
        if (deps.get(i) HAS target) then; idx = i; end;
    end;
    
    if (idx >= 0) then;
        deps.delete(idx);
        store.write("project.pax", toPax(cfg));
        >! tagOk() + " Removed " + C_BOLD + C_CYAN + target + C_RESET + ". Note: lib/ folders and pax.lock must be cleaned manually or via install.";
    end;
};

--- ================================================================
---   Registry & Publishing
--- ================================================================

func paxSearch(array:s: args) {
    if (args.size() < 4) then; return; end;
    s: q = args.get(3);
    >! tagPax() + " Searching Registry: " + C_BOLD + C_CYAN + q + C_RESET + "...";
    net.request {
        method = "GET", 
        url = getRegistryUrl() + "api?route=api/search&q=" + q,
        timeout = 10000,
    } as resp;
    if (resp.ok) then;
        s: body = s(resp.body);
        if (body.startsWith("[")) then;
            i: sz = resp.body.size();
            if (sz == 0) then; >! tagWarn() + " No matches."; return; end;
            i: ri = 0;
            while (ri < sz) do;
                json: res = resp.body.get(ri);
                s: n; res.bind("name", n);
                s: v; res.bind("version", v);
                s: a; res.bind("author_name", a);
                >! "  " + C_BOLD + C_CYAN + "- " + n + C_RESET + " (v" + v + ") by " + C_GREEN + a + C_RESET;
                ri = ri + 1;
            end;
        else;
            >! tagErr() + " Registry returned unexpected search response.";
        end;
    end;
};

func scanRecursive(s: dir, array:json: list) {
    array:s: items = store.list(dir);
    for item in items do;
        s: p = dir + item;
        if (store.isDir(p)) then;
            scanRecursive(p + "/", list);
        else;
            json: f <<< {"path": "", "content": ""} >>>;
            f.set("path", p);
            f.set("content", store.read(p));
            list.push(f);
        end;
    end;
};

func paxPublish() {
    if (NOT store.exists("project.pax")) then; return; end;
    s: token = getToken();
    if (token == "") then; >! tagErr() + " Login required."; return; end;
    
    json: cfg = parsePax(store.read("project.pax"));
    s: name; cfg.bind("name", name);
    s: ver;  cfg.bind("version", ver);
    
    s: zipFile = name + "_" + ver + ".zip";
    >! tagPax() + " Compressing project into " + zipFile + "...";
    
    if (NOT store.zip(".", zipFile)) then;
        halt.error >! "Failed to create project archive.";
        return;
    end;

    array:json: flLine;
    scanRecursive("./", flLine);
    array:json: flClean;
    i: fli = 0;
    i: flsz = flLine.size();
    while (fli < flsz) do;
        json: f = flLine.get(fli);
        s: fp; f.bind("path", fp);
        if (NOT fp.endsWith(".zip") AND NOT (fp HAS ".pax_token") AND NOT (fp HAS ".git")) then;
            flClean.push(f);
        end;
        fli = fli + 1;
    end;
    
    s: readme = "";
    i: q = 0;
    i: qsz = flClean.size();
    while (q < qsz) do;
        json: f = flClean.get(q);
        s: p; f.bind("path", p);
        if (p.lower() == "readme.md" OR p.lower() == "./readme.md") then;
            f.bind("content", readme);
        end;
        q = q + 1;
    end;
    
    json: payload <<< {"name": "", "version": "", "description": "", "readme_content": "", "zip_content": "", "contents_json": ""} >>>;
    payload.set("name", name);
    payload.set("version", ver);
    payload.set("description", cfg.get("description"));
    payload.set("readme_content", readme);
    payload.set("zip_content", crypto.hash(store.read(zipFile), "base64_encode"));
    payload.set("contents_json", flClean.toStr());
    
    >! tagPax() + " Pushing package archive to Registry...";
    map: pubHeaders {
        schema = [s <-> s]
        data = ["X-PAX-TOKEN" :: token, "Content-Type" :: "application/json"]
    };
    net.request {
        method = "POST",
        url = getRegistryUrl() + "api?route=api/publish",
        headers = pubHeaders,
        body = payload,
        timeout = 30000,
    } as resp;
    
    --- Cleanup
    store.delete(zipFile);
    
    if (resp.ok) then; 
        >! tagOk() + " Package published."; 
    else; 
        s: errMsg = "";
        if (resp.exists("text")) then;
            s: raw = s(resp.get("text")).trim();
            if (raw.startsWith("{")) then;
                json: parsed = json.parse(raw);
                if (parsed.exists("message")) then;
                    parsed.bind("message", errMsg);
                elif (parsed.exists("error")) then;
                    parsed.bind("error", errMsg);
                end;
            else;
                errMsg = raw;
            end;
        end;
        
        if (errMsg == "") then;
            resp.bind("error", errMsg);
        end;
        
        >! tagErr() + " Publish Failed (HTTP " + s(resp.get("status")) + "): " + errMsg;
    end;
};

--- ================================================================
---   Upgrade Management
--- ================================================================

func detectOS(-> s) {
    array:s: args = env.args();
    if (args.size() > 0) then;
        s: exe = args.get(0);
        if (exe HAS "\\" OR exe HAS ".exe") then;
            return "windows";
        end;
    end;
    s: home = env.get("HOME");
    if (home.startsWith("/Users") OR home.startsWith("/var/root")) then;
        return "macos";
    end;
    return "linux";
};

func getInstallDir(-> s) {
    array:s: args = env.args();
    if (args.size() == 0) then; return ""; end;
    s: exe = args.get(0).replace("\\", "/");
    array:s: parts = exe.split("/");
    s: result = "";
    i: stop = parts.size() - 2;
    if (stop <= 0) then; return ""; end;
    for i in 0 to (stop - 1) do;
        if (result != "") then; result = result + "/"; end;
        result = result + parts.get(i);
    end;
    return result;
};

func getLatestGitHubTag(-> s) {
    map: headers {
        schema = [s <-> s]
        data = ["User-Agent" :: "xcx-pax"]
    };
    net.request {
        method = "GET",
        url = "https://api.github.com/repos/xcxlang-org/xcx/releases/latest",
        headers = headers,
        timeout = 10000,
    } as resp;
    if (resp.ok) then;
        s: body = s(resp.body);
        if (body.startsWith("{")) then;
            json: data = resp.body;
            if (data.exists("tag_name")) then;
                s: tag;
                data.bind("tag_name", tag);
                return tag;
            end;
        end;
    end;
    return "";
};

func getLocalXcxVersion(-> s) {
    s: installDir = getInstallDir();
    s: vfile = installDir + "/lib/VERSION";
    if (store.exists(vfile)) then;
        return store.read(vfile).trim();
    end;
    if (store.exists("lib/VERSION")) then;
        return store.read("lib/VERSION").trim();
    end;
    return "unknown";
};

func upgradeXcxBinary(s: installDir, s: os) {
    s: tag = getLatestGitHubTag();
    if (tag == "") then;
        >! tagErr() + " Could not fetch latest release info from GitHub.";
        return;
    end;
    s: base = "https://github.com/xcxlang-org/xcx/releases/download/" + tag + "/";
    s: downloadName = "xcx";
    s: localName = "xcx";
    
    if (os == "windows") then;
        downloadName = "xcx.exe";
        localName = "xcx.exe";
    elif (os == "macos") then;
        downloadName = "xcx-macos";
        localName = "xcx";
    elif (os == "linux") then;
        downloadName = "xcx-linux";
        localName = "xcx";
    end;
    
    s: url = base + downloadName;
    >! tagPax() + " Downloading " + C_CYAN + downloadName + C_RESET + " version " + C_GREEN + tag + C_RESET + "...";
    map: headers {
        schema = [s <-> s]
        data = ["User-Agent" :: "xcx-pax"]
    };
    net.request {
        method = "GET",
        url = url,
        headers = headers,
        timeout = 60000,
    } as resp;
    if (resp.ok) then;
        s: destBinDir = installDir + "/bin";
        if (NOT store.exists(destBinDir)) then;
            store.mkdir(destBinDir);
        end;
        s: dest = destBinDir + "/" + localName;
        s: body = s(resp.body);
        if (store.write(dest, body)) then;
            >! tagOk() + " xcx binary updated at " + dest;
            if (os != "windows") then;
                .terminal !run "chmod +x " + dest;
            end;
        else;
            >! tagErr() + " Permission denied. Could not write to " + dest;
            if (os == "windows") then;
                >! "  Please run PowerShell/CMD as Administrator and try again.";
            else;
                >! "  Please check your write permissions or run with sudo and try again.";
            end;
        end;
    else;
        >! tagErr() + " Download failed (HTTP " + s(resp.status) + ").";
    end;
};

func fetchToolPackage(s: pkgName, s: destLibDir) {
    s: os = detectOS();
    s: url = getRegistryUrl() + "api?route=api/packages/" + pkgName + "/download&v=latest&format=json";
    s: token = getToken();
    map: headers {
        schema = [s <-> s]
        data = [EMPTY]
    };
    if (token != "") then; headers.insert("X-PAX-TOKEN", token); end;
    net.request {
        method = "GET",
        url = url,
        headers = headers,
        timeout = 15000,
    } as resp;
    if (resp.ok) then;
        s: body = s(resp.body);
        if (body.startsWith("{")) then;
            json: m = json.parse(body);
            json: fl;
            if (m.exists("files_list")) then;
                json: inner = m.get("files_list");
                if (inner.exists("files_list")) then;
                    fl = inner.get("files_list");
                else;
                    fl = inner;
                end;
            end;
            if (fl.size() == 0) then;
                >! tagErr() + " " + pkgName + " has no file manifest.";
            else;
                s: lp = destLibDir + "/";
                i: k = 0;
                i: sz = fl.size();
                while (k < sz) do;
                    json: fObj = fl.get(k);
                    s: p; fObj.bind("path", p);
                    s: c; fObj.bind("content", c);
                    s: pSlash = p.replace("\\", "/");
                    b: has_dir = pSlash HAS "/";
                    if (has_dir) then;
                        array:s: parts = pSlash.split("/");
                        s: curPath = lp;
                        for i in 0 to (parts.size() - 2) do;
                            curPath = curPath + parts.get(i) + "/";
                            if (NOT store.exists(curPath)) then; store.mkdir(curPath); end;
                        end;
                    end;
                    if (NOT store.write(lp + pSlash, c)) then;
                        >! tagErr() + " Permission denied writing package file: " + lp + pSlash;
                        if (os == "windows") then;
                            >! "  Please run PowerShell/CMD as Administrator and try again.";
                        else;
                            >! "  Please check your write permissions or run with sudo and try again.";
                        end;
                        return;
                    end;
                    if (pSlash.endsWith("/math.xcx") OR pSlash == "math.xcx") then;
                        if (NOT store.write(lp + "math.xcx", c)) then;
                            >! tagErr() + " Permission denied writing math.xcx file.";
                            return;
                        end;
                    end;
                    k = k + 1;
                end;
                >! tagOk() + " Updated " + C_BOLD + C_CYAN + pkgName + C_RESET;
            end;
        else;
            >! tagErr() + " Registry returned non-JSON structure for " + pkgName;
        end;
    else;
        >! tagErr() + " Status " + s(resp.status) + " for " + pkgName;
    end;
};

func upgradeTools(s: installDir) {
    s: libDir = installDir + "/lib";
    >! tagPax() + " Upgrading tools to latest from PAX registry...";
    fetchToolPackage("pax", libDir);
    fetchToolPackage("mathlib", libDir);
    fetchToolPackage("doc", libDir);
};

func paxUpgrade(array:s: args) {
    if (args.size() < 4) then;
        >! tagErr() + " Specify what to upgrade: xcx, tools, all";
        return;
    end;
    s: target = args.get(3);
    b: checkOnly = false;
    if (target == "--check") then;
        target = "all";
        checkOnly = true;
    end;
    if (args.size() >= 5) then;
        if (args.get(4) == "--check") then;
            checkOnly = true;
        end;
    end;
    if (target != "xcx" AND target != "tools" AND target != "all") then;
        >! tagErr() + " Unknown target '" + target + "'. Use: xcx, tools, all";
        return;
    end;
    s: os = detectOS();
    s: installDir = getInstallDir();
    if (installDir == "") then;
        >! tagErr() + " Could not determine install directory.";
        return;
    end;
    if (checkOnly) then;
        s: local = getLocalXcxVersion();
        s: remote = getLatestGitHubTag();
        if (remote == "") then;
            >! tagErr() + " Could not retrieve remote version from GitHub.";
            return;
        end;
        >! tagPax() + " Local version:  " + C_BOLD + local + C_RESET;
        >! tagPax() + " Latest release: " + C_BOLD + remote + C_RESET;
        if (local == remote OR "v" + local == remote) then;
            >! tagOk() + " Already up to date.";
        else;
            >! tagWarn() + " Update available: " + C_BOLD + C_CYAN + remote + C_RESET;
        end;
        return;
    end;
    if (target == "xcx" OR target == "all") then;
        upgradeXcxBinary(installDir, os);
    end;
    if (target == "tools" OR target == "all") then;
        upgradeTools(installDir);
    end;
    >! tagOk() + " Upgrade complete.";
};

main();
