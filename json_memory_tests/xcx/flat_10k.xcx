table: payload_tbl {
    columns = [ id :: i, name :: s, active :: b ]
    rows = [EMPTY]
};

for i in 0 to 9999 do;
    payload_tbl.add(i, "User_" + s(i), true);
end;

i: t0 = perf.us();

json: data = payload_tbl.toJson();
s: raw_str = data.toStr();
store.write("flat_10k_temp.json", raw_str);

s: read_str = "";
if (store.exists("flat_10k_temp.json")) then;
    read_str = store.read("flat_10k_temp.json");
    store.delete("flat_10k_temp.json");
end;

json: parsed = json.parse(read_str);
i: count = parsed.size();
json: mid_elem = parsed.get(5000);
s: name_mid;
mid_elem.bind("name", name_mid);

i: t1 = perf.us();
f: json_ms = f(t1 - t0) / 1000.0;
>! "json_elapsed_ms: " + s(json_ms);
