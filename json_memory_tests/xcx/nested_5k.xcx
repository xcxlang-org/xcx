json: parent <<< {"val": 0, "child": null} >>>;

i: t0 = perf.us();

for i in 1 to 100 do;
    json: new_parent <<< {"val": 0, "child": null} >>>;
    new_parent.set("val", i);
    new_parent.set("child", parent);
    parent = new_parent;
end;

s: serialized = parent.toStr();
json: parsed = json.parse(serialized);

json: explorer = parsed;
for k in 1 to 50 do;
    explorer = explorer.get("child");
end;
i: val_check;
explorer.bind("val", val_check);

i: t1 = perf.us();
f: json_ms = f(t1 - t0) / 1000.0;
>! "json_elapsed_ms: " + s(json_ms);
