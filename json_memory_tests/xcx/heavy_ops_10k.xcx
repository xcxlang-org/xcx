table: payload_tbl {
    columns = [ id :: i, name :: s, active :: b ]
    rows = [EMPTY]
};

for i in 0 to 9999 do;
    payload_tbl.add(i, "User_" + s(i), true);
end;

i: t0 = perf.us();

json: tbl_json = payload_tbl.toJson();

json: root_json <<< {"items": [], "meta": {"total": 0, "processed": false}} >>>;
i: tbl_size = tbl_json.size();
for i in 0 to (tbl_size - 1) do;
    json: item = tbl_json.get(i);
    
    s: name;
    item.bind("name", name);
    
    json: profile <<< {"id": 0, "username": "", "ratings": [], "flags": {"valid": false}} >>>;
    profile.set("id", i);
    profile.set("username", name);
    profile.get("ratings").push(10);
    profile.get("ratings").push(20);
    profile.get("ratings").push(30);
    profile.get("flags").set("valid", true);
    
    root_json.get("items").push(profile);
end;
root_json.get("meta").set("total", tbl_size);
root_json.get("meta").set("processed", true);

s: serialized_str = root_json.toStr();

json: parsed = json.parse(serialized_str);

json: meta = parsed.get("meta");
i: total_val;
meta.bind("total", total_val);

i: sample_idx = total_val / 2;
json: sample = parsed.get("items[" + s(sample_idx) + "]");
s: name_check;
sample.bind("username", name_check);

table: imported {
    columns = [ uid :: i, uname :: s ]
    rows = [EMPTY]
};
map: mapping {
    schema = [s<->s]
    data = [ "uid" :: "id", "uname" :: "username" ]
};
parsed.inject("items", mapping, imported);

i: t1 = perf.us();
f: json_ms = f(t1 - t0) / 1000.0;
>! "json_elapsed_ms: " + s(json_ms);
