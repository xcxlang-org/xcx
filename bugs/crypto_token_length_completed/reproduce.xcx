--- reproduce.xcx - Reproducer for crypto.token length ambiguity

>! "=================================================================";
>! "REPRODUCER: Crypto Token Length Mismatch";
>! "=================================================================";
>! "";

s: tok16 = crypto.token(16);
i: len = tok16.length;

>! "Calling crypto.token(16)...";
>! "Generated Token: " + tok16;
>! "Actual String Length: " + s(len);
>! "";
>! "Expected length if 'length' parameter means hex char count: 16";
>! "Expected length if 'length' parameter means byte count:     32";
>! "";

if (len == 16) then;
    >! "Behavior: crypto.token(N) generates N hex characters.";
    >! "Note: sys_modules_test.xcx expects 32 characters for crypto.token(16).";
elif (len == 32) then;
    >! "Behavior: crypto.token(N) generates N bytes (2*N hex characters).";
else;
    >! "Unexpected length: " + s(len);
end;
