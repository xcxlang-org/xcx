--- reproduce.xcx - Reproducer for VM raw mode key event duplication

.terminal !raw;
.terminal !cursor off;

>! "=================================================================";
>! "REPRODUCER: XCX VM Raw Mode Double Key Signal Bug";
>! "=================================================================";
>! "Please press ENTER exactly ONCE.";
>! "If the VM bug is active, the first keypress event (down)";
>! "will be read by the first call, and the keyrelease event (up)";
>! "will leak into the second call, instantly completing both reads.";
>! "=================================================================";
>! "";

s: k1 = input.key() @wait;
>! "Read 1: Got event for key: '" + k1 + "'";

>! "Now calling second read...";
s: k2 = input.key() @wait;
>! "Read 2: Got event for key: '" + k2 + "'";

.terminal !cursor on;
.terminal !normal;
>! "";
>! "Completed. If both printed without waiting for a second press, the bug reproduced.";
