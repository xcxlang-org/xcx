json: parent <<< {"val": 0, "child": null} >>>;

for i in 1 to 500 do;
    json: new_parent <<< {"val": 0, "child": null} >>>;
    new_parent.set("val", i);
    new_parent.set("child", parent);
    parent = new_parent;
end;

s: serialized = parent.toStr();
json: parsed = json.parse(serialized);
>! "Parsed successfully!";
